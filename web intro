<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Happy Birthday Seonghyeon</title>

<style>
    * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
    }

    body {
        overflow: hidden;
        background: #000;
    }

    /* =========================
       INTRO
    ========================= */

    #intro {
        position: fixed;
        inset: 0;
        z-index: 1000;

        display: flex;
        justify-content: center;
        align-items: flex-start;

        background: #000;

        animation: introDrop 4s ease-in-out forwards;
    }

    #intro img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
    }

    /* Intro xuất hiện từ trên xuống
       rồi biến mất lên trên */

    @keyframes introDrop {

        0% {
            transform: translateY(-100%);
            opacity: 0;
        }

        15% {
            transform: translateY(0);
            opacity: 1;
        }

        70% {
            transform: translateY(0);
            opacity: 1;
        }

        85% {
            transform: translateY(0);
            opacity: 1;
        }

        100% {
            transform: translateY(-100%);
            opacity: 0;
            visibility: hidden;
        }
    }


    /* =========================
       BIRTHDAY TEXT
    ========================= */

    #birthdayText {
        position: fixed;
        z-index: 900;

        top: 50%;
        left: 50%;

        transform: translate(-50%, -50%) scale(0);

        color: white;

        text-align: center;

        font-family: Arial, sans-serif;

        font-size: clamp(35px, 7vw, 100px);

        font-weight: 900;

        line-height: 1.1;

        letter-spacing: 5px;

        white-space: nowrap;

        text-shadow:
            0 0 10px white,
            0 0 25px #ff8bd8,
            0 0 50px #ff4fc3;

        opacity: 0;
    }

    #birthdayText.show {
        animation: textPop 1.5s
        cubic-bezier(.17,.67,.25,1.3)
        forwards;
    }

    @keyframes textPop {

        0% {
            transform:
                translate(-50%, -50%)
                scale(0);

            opacity: 0;
        }

        60% {
            transform:
                translate(-50%, -50%)
                scale(1.15);

            opacity: 1;
        }

        100% {
            transform:
                translate(-50%, -50%)
                scale(1);

            opacity: 1;
        }
    }


    /* =========================
       FIREWORK CANVAS
    ========================= */

    #fireworks {
        position: fixed;

        inset: 0;

        width: 100%;
        height: 100%;

        z-index: 400;

        pointer-events: none;
    }

</style>
</head>


<body>


<!-- =========================
     INTRO IMAGE
========================= -->

<div id="intro">

    <!-- ĐỔI PSD THÀNH intro.JPG Ở ĐÂY -->

    <img src="intro.JPG" alt="Intro">

</div>


<!-- =========================
     FIREWORKS
========================= -->

<canvas id="fireworks"></canvas>


<!-- =========================
     BIRTHDAY TEXT
========================= -->

<div id="birthdayText">
    HAPPY BIRTHDAY<br>
    SEONGHYEON
</div>


<script>

/* =========================
   CANVAS SETUP
========================= */

const canvas =
    document.getElementById("fireworks");

const ctx =
    canvas.getContext("2d");


function resizeCanvas() {

    canvas.width = window.innerWidth;

    canvas.height = window.innerHeight;

}

resizeCanvas();


window.addEventListener(
    "resize",
    resizeCanvas
);


/* =========================
   FIREWORK ARRAYS
========================= */

let fireworks = [];

let particles = [];


/* =========================
   FIREWORK
========================= */

class Firework {

    constructor() {

        this.x =
            Math.random() *
            canvas.width;

        this.y =
            canvas.height;

        this.targetY =
            Math.random() *
            canvas.height *
            0.45
            +
            canvas.height * 0.1;

        this.speed =
            7 +
            Math.random() * 4;

        this.exploded = false;
    }


    update() {

        this.y -= this.speed;


        if (
            this.y <=
            this.targetY
        ) {

            this.explode();

            this.exploded = true;
        }

    }


    explode() {

        const amount = 100;


        for (
            let i = 0;
            i < amount;
            i++
        ) {

            const angle =
                Math.PI * 2 *
                i / amount;


            const speed =
                Math.random() * 6 + 2;


            particles.push(

                new Particle(

                    this.x,

                    this.y,

                    Math.cos(angle) *
                    speed,

                    Math.sin(angle) *
                    speed

                )

            );

        }

    }


    draw() {

        ctx.beginPath();


        ctx.arc(

            this.x,

            this.y,

            2,

            0,

            Math.PI * 2

        );


        ctx.fillStyle = "white";


        ctx.fill();

    }

}


/* =========================
   PARTICLE
========================= */

class Particle {

    constructor(
        x,
        y,
        vx,
        vy
    ) {

        this.x = x;

        this.y = y;

        this.vx = vx;

        this.vy = vy;

        this.life = 1;

        this.gravity = 0.04;

    }


    update() {

        this.x += this.vx;

        this.y += this.vy;


        this.vy +=
            this.gravity;


        this.vx *= 0.98;

        this.vy *= 0.98;


        this.life -= 0.012;

    }


    draw() {

        ctx.beginPath();


        ctx.arc(

            this.x,

            this.y,

            2,

            0,

            Math.PI * 2

        );


        ctx.fillStyle =
            `rgba(
                255,
                255,
                255,
                ${this.life}
            )`;


        ctx.shadowBlur = 15;

        ctx.shadowColor =
            "white";


        ctx.fill();


        ctx.shadowBlur = 0;

    }

}


/* =========================
   MAIN ANIMATION
========================= */

function animate() {


    ctx.fillStyle =
        "rgba(0,0,0,0.2)";


    ctx.fillRect(

        0,

        0,

        canvas.width,

        canvas.height

    );


    /* FIREWORKS */

    fireworks.forEach(
        (firework, index) => {

            firework.update();

            firework.draw();


            if (
                firework.exploded
            ) {

                fireworks.splice(
                    index,
                    1
                );

            }

        }
    );


    /* PARTICLES */

    particles.forEach(
        (particle, index) => {

            particle.update();

            particle.draw();


            if (
                particle.life <= 0
            ) {

                particles.splice(
                    index,
                    1
                );

            }

        }
    );


    requestAnimationFrame(
        animate
    );

}


animate();


/* =========================
   START FIREWORKS
========================= */

/*
   Intro animation:
   4 seconds

   → sau 4 giây bắt đầu pháo hoa
*/

setTimeout(() => {


    /* HIỆN CHỮ */

    document
        .getElementById(
            "birthdayText"
        )
        .classList.add("show");


    /* PHÁO HOA BAN ĐẦU */

    for (
        let i = 0;
        i < 8;
        i++
    ) {

        setTimeout(() => {

            fireworks.push(
                new Firework()
            );

        }, i * 250);

    }


    /* PHÁO HOA TIẾP TỤC */

    setInterval(() => {

        fireworks.push(
            new Firework()
        );

    }, 900);


}, 4000);

</script>

</body>
</html>
